{
  "model": "claude-sonnet-5",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reinject-rules"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reinject-rules-subagent"
          }
        ]
      }
  "permissions": {
    "deny": [
      "Bash(sed -i:*)",
      "Bash(sed --in-place:*)",
      "Bash(gsed -i:*)",
      "Bash(gsed --in-place:*)",
      "Bash(perl -i:*)",
      "Bash(perl -pi:*)",
      "Bash(ruby -i:*)",
      "Bash(awk -i inplace:*)",
      "Bash(gawk -i inplace:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
